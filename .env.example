# ARF-OS environment template. Copy to .env and fill in.
#
# Spec 17.3: secrets live only in environment variables or a secret manager,
# never in prompts, logs, source, alerts, or artefacts. .env is gitignored.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
# Shown in the web app's environment badge (spec 15.2). Protected holdout data
# must never be loaded outside production (spec 20.2).
ARF_ENVIRONMENT=local
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# PostgreSQL — matches infra/docker/docker-compose.yml
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://arf:arf_local_dev@localhost:5432/arf
# Separate database for integration tests; safe to truncate between runs.
TEST_DATABASE_URL=postgresql://arf:arf_local_dev@localhost:5433/arf_test

# ---------------------------------------------------------------------------
# Redis / BullMQ
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Object storage (MinIO locally, Cloudflare R2 or S3 in deployed environments)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=arf_local
S3_SECRET_ACCESS_KEY=arf_local_dev_secret
S3_BUCKET_ARTEFACTS=arf-artefacts
S3_BUCKET_UPLOADS=arf-uploads
# MinIO requires path-style addressing; most S3 providers do not.
S3_FORCE_PATH_STYLE=true
# Lifetime of presigned upload/download URLs, in seconds (spec 17.3).
S3_PRESIGN_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# Authentication (Clerk)
# ---------------------------------------------------------------------------
# Leave blank to use the development auth stub. The stub is refused when
# ARF_ENVIRONMENT is not "local", so a deployed environment cannot start
# without real credentials.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---------------------------------------------------------------------------
# Model providers
# ---------------------------------------------------------------------------
# The agent runtime is provider-agnostic (spec 14.1). Set only what you use;
# in development the deterministic fixture provider needs no key at all.
ANTHROPIC_API_KEY=
AGENT_PROVIDER=fixture
# Hard ceiling per campaign, in USD. The orchestrator stops issuing new tasks
# when this is reached (leader prompt 11, "Budget exceeded").
AGENT_CAMPAIGN_BUDGET_USD=25

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PORT=3001
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Forward-test webhook
# ---------------------------------------------------------------------------
# TradingView alerts cannot send custom auth headers, so each deployment gets
# its own high-entropy path token (spec 13.6). This secret derives them.
WEBHOOK_TOKEN_SIGNING_SECRET=
# Reject signals whose bar time is further than this from now, in seconds.
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=arf-os
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Backtest worker
# ---------------------------------------------------------------------------
# How often the outbox relay polls for committed-but-unpublished events.
OUTBOX_POLL_MS=1000
WORKER_CONCURRENCY=4
# Ingestion needs the chart timezone the export was taken in and the initial
# capital. Neither can be guessed: a wrong timezone shifts every trade and can
# move it across a segment boundary. These defaults apply until the values are
# captured on the verification row itself.
INGESTION_DEFAULT_TIMEZONE=Etc/UTC
INGESTION_DEFAULT_CAPITAL=10000
